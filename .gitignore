# ==============================================================================
# YOKOHAMA ILUO PORTAL - .gitignore
# ==============================================================================

# Environment & Credentials
.env
.env*
!.env.example

# Node Dependencies
node_modules/
npm-debug.log*

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
scripts/__pycache__/

# Ephemeral Logs & Output Dumps
*.log
*.txt
output_docx/
pdf_reports/
temp_all_docx/
temp_docx/

# Dynamic Plant Production State Files (Preserved Locally/On Server)
assessment_records*.json
custom_employees*.json
ojt_evaluations*.json
custom_settings*.json

# Vercel Deployment Cache
.vercel

# Android / Mobile Builds & Workspace Projects
*.apk
*.keystore
capacitor.config.json
android/
www/

# Reference Archives & Large Offline Datasets
archive_pregen_pdfs/
data/reference_workbooks/
docs/reference/

# Operating System Metadata
.DS_Store
Thumbs.db
Desktop.ini
