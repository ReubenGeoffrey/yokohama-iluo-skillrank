{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
          "includeFiles": [
            "index.html",
            "app.js",
            "data.js",
            "styles.css",
            "ojt_templates_data.js",
            "seed_data.js",
            "assessment_records.json",
            "ojt_evaluations.json",
            "custom_questions.json",
            "custom_employees.json",
            "docx_generator.js",
            "jszip.min.js",
            "yokohama_logo.png",
            "mammoth.browser.min.js",
            "xlsx.full.min.js",
            "QC_templates/**",
            "assets/**"
          ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
