{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
          "maxLambdaSize": "50mb",
          "includeFiles": [
            "index.html",
            "employee.html",
            "app.js",
            "employee.js",
            "data.js",
            "styles.css",
            "ojt_templates_data.js",
            "seed_data.js",
            "manifest.json",
            "assessment_records.json",
            "ojt_evaluations.json",
            "custom_questions.json",
            "custom_employees.json",
            "docx_generator.js",
            "report_html_generator.js",
            "html2pdf.bundle.min.js",
            "jszip.min.js",
            "atg_logo.png",
            "yokohama_logo.png",
            "favicon.ico",
            "mammoth.browser.min.js",
            "docx-preview.min.js",
            "xlsx.full.min.js",
            "seed_ojt.js",
            "shared_constants.js",
            "master_excel_b64.js",
            "excel_sync_engine.js",
            "master_questions.json",
            "audit_logs.json",
            "custom_settings.json",
            "public/**",
            "QC_templates/**",
            "assets/**"
          ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/employee",
      "dest": "server.js"
    },
    {
      "src": "/employee.html",
      "dest": "server.js"
    },
    {
      "src": "/management",
      "dest": "server.js"
    },
    {
      "src": "/management.html",
      "dest": "server.js"
    },
    {
      "src": "/index.html",
      "dest": "server.js"
    },
    {
      "src": "/",
      "dest": "server.js"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "server.js",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'"
      }
    }
  ]
}
